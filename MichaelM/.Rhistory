scatter_data <- data.frame(
HST = test_data$HST,
AST = test_data$AST,
FTR = factor(test_data$FTR, levels = c("H", "D", "A"))
)
library(ggplot2)
ggplot(scatter_data, aes(x = HST, y = AST, colour = FTR)) +
geom_jitter(width = 0.2, height = 0.2, alpha = 0.45, size = 1.8) +
geom_abline(
slope = 1,
intercept = 0,
linetype = "dashed",
colour = "grey30"
) +
scale_colour_manual(
values = c("H" = "steelblue", "D" = "darkorange", "A" = "firebrick"),
labels = c("H" = "Home win", "D" = "Draw", "A" = "Away win")
) +
labs(
title = "Shots on Target by Full-Time Match Result",
x = "Home-team shots on target (HST)",
y = "Away-team shots on target (AST)",
colour = "Match result"
) +
theme_minimal(base_size = 12)
