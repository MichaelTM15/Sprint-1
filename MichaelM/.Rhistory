# Initializing with a given seed in order to be repeatable
set.seed(123)
svm_tuning_NB<-tune(svm, FTR~., data=train_data_NB[, c("FTR", selected_predictors)],
kernel="radial", ranges=list(cost=c(0.5,2,8), gamma=c(0.01,0.05,0.2)),
tunecontrol=tune.control(cross=5))
library(e1071)
# Initializing with a given seed in order to be repeatable
set.seed(123)
svm_tuning_NB<-tune(svm, FTR~., data=train_data_NB[, c("FTR", selected_predictors)],
kernel="radial", ranges=list(cost=c(0.5,2,8), gamma=c(0.01,0.05,0.2)),
tunecontrol=tune.control(cross=5))
best_parameters_NB<-svm_tuning_NB$best.parameters
best_svm_NB<-svm_tuning_NB$best.model
saveRDS(list(
best_svm_NB=best_svm_NB,
best_parameters_NB=best_parameters_NB,
svm_tuning_NB=svm_tuning_NB
),
"../MichaelM/best_svm_model_NB.rds")
